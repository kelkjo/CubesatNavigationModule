// Пины подключения
#define LASER_PIN 5
#define SERVO_PAN_PIN 2    // поворот (горизонтальная ось)
#define SERVO_TILT_PIN 3  // наклон (вертикальная ось)

// Параметры системы
#define STEP_ANGLE 10      // шаг 10 градусов
#define MIN_ANGLE 0        // минимальный угол
#define MAX_ANGLE 180      // максимальный угол
#define INIT_PAN 0        // начальное положение поворота (центр)
#define INIT_TILT 0     // начальное положение наклона (центр)

// Структура для данных управления
struct ControlData {
  int panAngle;     // угол поворота (0-180)
  int tiltAngle;
  char position = '0';
  unsigned long id;    // угол наклона (0-180)    // команда сброса
};

// Объекты
RF24 radio(10, 9); // CE, CSN пины для nRF24L01
Servo panServo;
Servo tiltServo;

// Адрес радиоканала
const byte address[6] = "00001";

// Текущие углы
int currentPan = INIT_PAN;
int currentTilt = INIT_TILT;

struct ModuleInfo {
  uint32_t uid;          // Уникальный ID
  char name[16];         // Имя модуля
  uint8_t version;       // Версия ПО
  uint8_t moduleType;    // Тип модуля (0=неизвестно, 1=наведение, 2=питание, и т.д.)
  uint32_t serialNumber; // Серийный номер
};

ModuleInfo myModule;

void initializeModuleInfo() {
  // Проверяем, есть ли сохраненная информация
  ModuleInfo stored;
  EEPROM.get(0, stored);
  
  if (stored.uid != 0 && stored.uid != 0xFFFFFFFF) {
    // Используем сохраненную информацию
    myModule = stored;
    Serial.println("Загружена сохраненная информация модуля");
  }
}

void setup() {
  Serial.begin(9600);
  initializeModuleInfo();
  // Инициализация лазера
  pinMode(LASER_PIN, OUTPUT);
  digitalWrite(LASER_PIN, HIGH);
  
  // Инициализация сервоприводов
  panServo.attach(SERVO_PAN_PIN);
  tiltServo.attach(SERVO_TILT_PIN);
  
  // Установка в начальное положение
  panServo.write(INIT_PAN);
  tiltServo.write(INIT_TILT);
  tiltServo.write(53);
  panServo.write(53);
  delay(1000);
  
  // Инициализация радиомодуля
  if (!radio.begin()) {
    Serial.println("Radio module failed!");
    while (1);
  }
  
  radio.openReadingPipe(0, address);
  radio.setPALevel(RF24_PA_MIN);
  radio.startListening();
  
  Serial.println("System initialized. Waiting for commands...");
}


#include <SPI.h>
#include <nRF24L01.h>
#include <RF24.h>

// Структура данных
struct ControlData {
  int panAngle;
  int tiltAngle;
  char position;
  unsigned long id;
};

RF24 radio(9, 10); // CE, CSN
const byte address[6] = "00001";
char flag1 = '1';
char flag0 = '0';


void setup() {
  Serial.begin(9600);
  
  int a = radio.begin();
  Serial.println(a);
  radio.openWritingPipe(address);
  radio.setPALevel(RF24_PA_MIN);
  radio.stopListening();
}
ControlData data;
void loop() {
  // Чтение команд с последовательного порта
  if (Serial.available()) {
    char command = Serial.read();
    
    if (command == '1'){
      radio.write(&flag1, sizeof(flag1));
      radio.openReadingPipe(1, address);
      radio.startListening();
      Serial.println("Готовы принимать данные");
      int flag = 1;
      while (flag){
        if (radio.available()){
          radio.read(&data, sizeof(data));
          if (data.panAngle == 180 && data.tiltAngle == 180){
            Serial.println("Success");
            break;
          }
          Serial.println("ID:");
          Serial.println(data.id, HEX);
          Serial.println("Состояние:");
          Serial.println(data.position);
          Serial.println("Угол поворота:");
          Serial.println(data.panAngle);
          Serial.println("Угол наклона:");
          Serial.println(data.tiltAngle);
        }
      }
      radio.stopListening();
      radio.openWritingPipe(address);
    }
    else{
      Serial.println("Введена неверная команда"); 
      Serial.println("Введена неверная команда");
    }
  }
}
